# Copy this to .env for local development
# In production (Railway/Render), set these as environment variables in the dashboard

SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=ngomacharts.co.ke,api.ngomacharts.co.ke,localhost
DATABASE_URL=postgresql://user:password@host:5432/dbname
CORS_ALLOWED_ORIGINS=https://ngomacharts.co.ke,https://www.ngomacharts.co.ke
CSRF_TRUSTED_ORIGINS=https://ngomacharts.co.ke,https://api.ngomacharts.co.ke

# Optional Google Drive storage for CMS media, uploaded files, and backups.
# Create folders in Google Drive, share them with the Google service-account
# client_email, then paste the Drive folder IDs here.
GOOGLE_DRIVE_STORAGE_OWNER_EMAILS=wickielangat99@gmail.com,ngomacharts@gmail.com
GOOGLE_DRIVE_STORAGE_FOLDER_ID=primary-drive-folder-id
GOOGLE_DRIVE_MIRROR_FOLDER_IDS=second-drive-folder-id
GOOGLE_DRIVE_CREDENTIALS_B64=base64-encoded-service-account-json
GOOGLE_DRIVE_PUBLIC_READ=True
GOOGLE_DRIVE_PUBLIC_PREFIXES=platforms/,artists/,covers/,news/,admin-users/,cms-media/

# For custom React CMS session auth when frontend/backend are on different domains:
# Use None only with HTTPS in production.
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
